DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to PHP in FastCGI / Apache environments
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Allow direct access to server/ backend API without rewriting
    RewriteRule ^server(/.*)?$ - [L]

    # Map subpath asset requests (e.g. /admin/assets/* or /download/assets/*) back to root assets
    RewriteRule ^(.+/)?assets/(.*)$ assets/$2 [L]
    RewriteRule ^(.+/)?(favicon\.svg|icons\.svg)$ $2 [L]

    # Serve existing physical files directly (CSS, JS, SVG, images)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all clean SPA URLs (/admin, /download, etc.) to index.html
    RewriteRule ^ index.html [L]
</IfModule>

